# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=           # Supabase project URL (e.g. https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Public anon key — safe to expose
SUPABASE_SERVICE_ROLE_KEY=          # SECRET — server only, NEVER NEXT_PUBLIC_
DATABASE_URL=                       # Postgres connection string (Drizzle Kit migrations)

# ── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=                     # Get from resend.com
EMAIL_FROM=                         # e.g. noreply@auraarchives.com

# ── AI (Anthropic) ───────────────────────────────────────
ANTHROPIC_API_KEY=                  # Get from console.anthropic.com — server only
AI_MONTHLY_BUDGET_USD=10            # Stop AI requests if monthly cost exceeds this

# ── Redis (Upstash) ──────────────────────────────────────
UPSTASH_REDIS_REST_URL=             # Get from console.upstash.com
UPSTASH_REDIS_REST_TOKEN=           # Get from console.upstash.com

# ── Error Tracking (Sentry) ──────────────────────────────
SENTRY_DSN=                         # Get from sentry.io
NEXT_PUBLIC_SENTRY_DSN=             # Same value as SENTRY_DSN (client-side)
SENTRY_AUTH_TOKEN=                  # For source map uploads in CI

# ── Analytics (PostHog) ──────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=            # Get from posthog.com
NEXT_PUBLIC_POSTHOG_HOST=           # https://app.posthog.com

# ── Background Jobs (Inngest) ────────────────────────────
INNGEST_EVENT_KEY=                  # Get from inngest.com
INNGEST_SIGNING_KEY=                # Get from inngest.com

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=                # https://auraarchives.com (or vercel preview URL)
NEXT_PUBLIC_APP_NAME=Aura Archives
NODE_ENV=development                # development | production | test
MAINTENANCE_MODE=false              # true | false
